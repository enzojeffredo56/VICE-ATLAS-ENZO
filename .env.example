# Copie ce fichier en .env.local puis renseigne les valeurs.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mets JAMAIS de secret.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (phase 4) — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets serveur uniquement (phases ultérieures) — ne jamais préfixer NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   (clé restreinte par domaine, phase 3)
