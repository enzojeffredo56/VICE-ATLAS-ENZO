# Copie ce fichier en .env.local (en local) et renseigne les mêmes variables sur Vercel.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mets JAMAIS de secret.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secrets serveur uniquement (jamais NEXT_PUBLIC_) ---
# Clé « service_role » : tâches planifiées et webhooks uniquement
SUPABASE_SERVICE_ROLE_KEY=
# Secret partagé avec la tâche planifiée Vercel (24 caractères minimum)
CRON_SECRET=

# Stripe (commencer en MODE TEST : clés sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
# Les paiements restent fermés tant que cette valeur n'est pas « true »
PAYMENTS_ENABLED=false
